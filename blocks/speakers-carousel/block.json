{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "crownspeakers/speakers-carousel",
  "version": "1.0.0",
  "title": "Speakers Carousel",
  "category": "crownspeakers",
  "icon": "grid-view",
  "description": "Speakers Carousel",
  "example": {
    "viewportWidth": 1200
  },
  "supports": {
    "html": false,
    "align": ["full"]
  },
  "attributes": {
    "autoplay": {
      "type": "boolean",
      "default": false
    },
    "showTabs": {
      "type": "boolean",
      "default": true
    },
    "background": {
      "type": "string",
      "default": "none",
      "enum": ["none", "light"]
    },
    "logos": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object"
      }
    }
  },
  "textdomain": "crownspeakers",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
