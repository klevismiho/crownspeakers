{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "crownspeakers/topics-grid",
	"version": "1.0.0",
	"title": "Topics Grid",
	"category": "crownspeakers",
	"icon": "grid-view",
	"description": "Grid of all speaker topics",
	"example": {
		"viewportWidth": 1200
	},
	"supports": {
		"html": false,
		"align": ["full"]
	},
	"attributes": {
		"heading": {
			"type": "string",
			"default": "Start with what<br>matters to your audience."
		}
	},
	"textdomain": "crownspeakers",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
