{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "crownspeakers/split-content",
  "version": "1.0.0",
  "title": "Split Content",
  "category": "crownspeakers",
  "icon": "columns",
  "description": "Eyebrow and heading beside text",
  "example": {
    "viewportWidth": 1200,
    "attributes": {
      "eyebrow": "Our story",
      "title": "Oklahoma roots.<br>A wider perspective."
    }
  },
  "supports": {
    "html": false,
    "align": [
      "full"
    ]
  },
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "title": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "crownspeakers",
  "editorScript": "file:./index.js",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}